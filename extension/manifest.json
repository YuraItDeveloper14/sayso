{
  "manifest_version": 3,
  "name": "StaySo",
  "version": "1.0.0",
  "description": "Voice control for your browser tabs. Talks to the StaySo daemon running on this machine.",
  "permissions": ["tabs", "sessions", "scripting", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1:5000/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "StaySo",
    "default_icon": "icons/icon128.png"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
